datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model Usuario {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String        @db.VarChar
  telefone   String        @unique @db.VarChar
  senha      String?       @db.VarChar
  role       String        @default("USER") @db.VarChar
  ativo      Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  limites    LimiteGasto[]
  transacoes Transacao[]

  @@map("usuarios")
}

model Categoria {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String        @db.VarChar
  tipo       String        @db.VarChar
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  limites    LimiteGasto[]
  transacoes Transacao[]

  @@index([nome])
  @@map("categorias")
}

model LimiteGasto {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  categoriaId String    @map("categoria_id") @db.Uuid
  valorLimite Decimal   @map("valor_limite") @db.Decimal
  mesAno      String    @map("mes_ano") @db.VarChar
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, categoriaId, mesAno])
  @@index([usuarioId, mesAno])
  @@map("limites_gastos")
}

model Transacao {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId       String      @map("usuario_id") @db.Uuid
  categoriaId     String?     @map("categoria_id") @db.Uuid
  descricao       String      @db.Text
  valor           Decimal     @db.Decimal
  tipoTransacao   String      @map("tipo_transacao") @db.VarChar
  metodoPagamento String      @map("metodo_pagamento") @db.VarChar
  ehParcelado     Boolean     @default(false) @map("eh_parcelado")
  parcelaAtual    Int         @default(1) @map("parcela_atual")
  totalParcelas   Int         @default(1) @map("total_parcelas")
  transacaoPaiId  String?     @map("transacao_pai_id") @db.Uuid
  dataTransacao   DateTime    @default(now()) @map("data_transacao") @db.Timestamptz
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  usuario        Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria      Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  transacaoPai   Transacao? @relation("Parcelas", fields: [transacaoPaiId], references: [id], onDelete: SetNull)
  parcelasFilhas Transacao[]@relation("Parcelas")

  @@index([usuarioId, dataTransacao(sort: Desc)])
  @@index([usuarioId, tipoTransacao])
  @@index([usuarioId, categoriaId])
  @@index([transacaoPaiId])
  @@map("transacoes")
}
